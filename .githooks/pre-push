#!/bin/sh
# Guards a push: branch naming convention, no leftover merge-conflict
# markers, no oversized files, and (when g++ is on PATH) changed C++
# files must at least parse.

z40=0000000000000000000000000000000000000000
max_bytes=5242880

branch_name=$(git rev-parse --abbrev-ref HEAD)
valid_branch_regex="^(main|staging|release/[0-9]{4}-[0-9]{2}-[0-9]{2}|feature/.+|fix/.+|bugfix/.+|hotfix/.+|chore/.+|backfill/.+)$"

if ! printf '%s' "$branch_name" | grep -qE "$valid_branch_regex"; then
  echo "pre-push: branch name '$branch_name' does not follow the naming convention." >&2
  echo "Use one of:" >&2
  echo "  - main" >&2
  echo "  - staging" >&2
  echo "  - release/yyyy-mm-dd" >&2
  echo "  - feature/xxx" >&2
  echo "  - fix/xxx" >&2
  echo "  - bugfix/xxx" >&2
  echo "  - hotfix/xxx" >&2
  echo "  - chore/xxx" >&2
  echo "  - backfill/xxx" >&2
  exit 1
fi

fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue  # branch deletion, nothing to check

  if [ "$remote_sha" = "$z40" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  changed_files=$(git diff "$range" --name-only --diff-filter=ACM 2>/dev/null)
  [ -z "$changed_files" ] && continue

  echo "$changed_files" | while IFS= read -r f; do
    [ -f "$f" ] || continue
    if grep -qE '^(<<<<<<<|=======|>>>>>>>)' "$f" 2>/dev/null; then
      echo "pre-push: merge conflict markers left in $f" >&2
      exit 1
    fi
  done || fail=1

  echo "$changed_files" | while IFS= read -r f; do
    [ -f "$f" ] || continue
    size=$(wc -c < "$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$max_bytes" ]; then
      echo "pre-push: $f is $size bytes, over the ${max_bytes}-byte limit" >&2
      exit 1
    fi
  done || fail=1

  if command -v g++ >/dev/null 2>&1; then
    cpp_changed=$(echo "$changed_files" | grep -E '\.(cpp|cc|cxx)$')
    for f in $cpp_changed; do
      [ -f "$f" ] || continue
      err=$(g++ -fsyntax-only -std=c++17 "$f" 2>&1)
      if [ $? -ne 0 ]; then
        echo "pre-push: $f failed to compile:" >&2
        echo "$err" >&2
        fail=1
      fi
    done
  fi
done

exit $fail
